        "unit": "Hz",
        "min": 10,
        "max": 2000,
        "step": 1,
        "default": 80,
        "interpolable": false
      },
      "slope_db_oct": {
        "kind": "enum",
        "label": "Inclinação",
        "options": [
          {
            "value": "6",
            "label": "6 dB/oct"
          },
          {
            "value": "12",
            "label": "12 dB/oct"
          },
          {
            "value": "18",
            "label": "18 dB/oct"
          },
          {
            "value": "24",
            "label": "24 dB/oct"
          }
        ],
        "default": "12"
      }
