{
  "gain": {
    "label": "Ganho",
    "description": "Ajusta o volume.",
    "params": {
      "gain_db": {
        "kind": "number",
        "label": "Ganho",
        "unit": "dB",
        "min": -24,
        "max": 24,
        "step": 0.1,
        "default": 0,
        "interpolable": true,
        "neutral": 0
      }
    }
  },
  "highpass": {
    "label": "Filtro passa-altas",
    "description": "Remove graves indesejados.",
