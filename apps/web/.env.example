# ---- Públicas (vão para o navegador) ----
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Somente servidor (NUNCA expor) ----
# Usada no painel admin e na página de convite (/r/<código>).
SUPABASE_SERVICE_ROLE_KEY=

# ---- Exportação no servidor (Etapa 4; desligada por padrão: system_settings.export_server_enabled) ----
# O app continua processando no aparelho quando o servidor está desligado, indisponível ou recusa o job.
# Cloudflare R2 (bucket privado "mixpro-exports", token Object Read & Write só nesse bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mixpro-exports
# Google Cloud (Cloud Tasks + Cloud Run). Só em Production na Vercel, nunca com prefixo NEXT_PUBLIC_.
GCP_PROJECT_ID=
GCP_REGION=us-central1
EXPORT_TASKS_QUEUE=mixpro-export
# URL do Cloud Run (sai do roteiro infra/gcp/deploy.sh)
EXPORT_SERVICE_URL=
# Serviço pesado (separação de faixas e modo álbum) e fila do Plano Pro (também saem do deploy.sh).
# Sem EXPORT_STEMS_URL, a separação no servidor fica indisponível; sem a fila Pro, todos usam a fila comum.
EXPORT_STEMS_URL=
EXPORT_TASKS_QUEUE_PRO=mixpro-export-pro
# Acesso sem chave (recomendado): provedor do Workload Identity Federation (sai de infra/gcp/wif-vercel.sh)
GCP_WIF_PROVIDER=
# Alternativa com chave JSON da conta "export-enqueuer" (uma linha só), se a organização permitir
GCP_SERVICE_ACCOUNT_JSON=

# Pagamentos (Mercado Pago)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# ---- Notificações diárias (Web Push / VAPID) ----
# Gere com: node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://seu-dominio
# Segredo que a Vercel envia ao chamar o cron (Authorization: Bearer ...)
CRON_SECRET=
