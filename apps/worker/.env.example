# Worker de áudio — só precisa de HTTPS de saída (nenhuma porta aberta).
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=mixpro-audio
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Identificação e ajustes (opcionais)
WORKER_ID=pc-estudio
WORKER_SOURCE_CACHE_MB=2048
WORKER_POLL_MIN_S=1
WORKER_POLL_MAX_S=5

# Mix Profissional — sincronização de stems para o PC do admin (Fase 7)
# Pasta local onde o worker baixa os stems prontos para mixagem
PRO_SYNC_DIR=C:\MixPro\Stems
# Desative se não quiser que este worker sincronize pedidos pro
PRO_SYNC_ENABLED=true
